# Copy this file to ".env" and tweak if you like. Everything here has a sensible
# default in config.py, so the project runs fine with NO .env at all.
# Open-Meteo needs no API key, so there are no secrets in here — but get into the
# habit now: real pipelines keep config and secrets in .env, never in code.

# Where the data lake is written (default: ./data next to the code)
# DATA_DIR=./data

# The API endpoint (you won't normally change this)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Timezone for returned timestamps. Keep UTC for a sane data lake.
# OPEN_METEO_TIMEZONE=UTC

# Network behaviour
# REQUEST_TIMEOUT=15
# MAX_RETRIES=3
